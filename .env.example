# VibeAcademy environment variables.
# Copy to .env.local for development. Never commit real values.
# Every variable is optional in development; production requirements are noted.

# --- Site ---------------------------------------------------------------
# Public base URL, used for share links and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
# Leave empty in development: an embedded PGlite database is created in .data/pglite.
# Production: a Postgres connection string (Neon, Supabase, RDS...). Run `pnpm db:migrate` on deploy.
DATABASE_URL=
# Where the embedded dev database lives. Use memory:// for a throwaway database.
PGLITE_DATA_DIR=.data/pglite

# --- Privacy and hashing -------------------------------------------------
# Secret used to HMAC prompts (cache keys) and IP addresses (rate limits).
# REQUIRED in production. Generate with: openssl rand -base64 32
HASH_SECRET=

# Use on only if all requests pass through a proxy that strips client-supplied
# X-Forwarded-For and X-Real-IP and sets the visitor address itself.
# With off, all visitors share each endpoint's rate limit.
TRUST_PROXY=off

# --- Accounts (Better Auth, Google only; ADR 0010) ----------------------------
# Without both Google values the site works signed out and the sign-in page says
# sign-in is not set up yet. Create an OAuth client at console.cloud.google.com
# with the redirect URI <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Signs session cookies; derived from HASH_SECRET when empty.
# Changing it (or HASH_SECRET when this is empty) signs everyone out.
AUTH_SECRET=

# --- Analysis engine -------------------------------------------------------
# rules (default): the rule-based X-Ray check. Runs on this server, no API key, no cost.
# anthropic: AI-assisted classification. DEFERRED: built and tested against mocks only, kept
#   as a placeholder for a later milestone (docs/roadmap.md, "Later: AI-assisted X-Ray").
#   Used only when AI_PROVIDER=anthropic is set explicitly; a key alone never switches it on.
AI_PROVIDER=rules
# Only read when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
AI_MODEL_XRAY=claude-haiku-5-5
# Hard cap on total AI spend per UTC day, in US dollars. Requests stop when reached.
AI_DAILY_BUDGET_USD=2

# --- Feature flags (kill switches) --------------------------------------
FEATURE_XRAY=on
FEATURE_WAITLIST=on

# --- Usage limits ----------------------------------------------------------
# X-Ray runs allowed per visitor (hashed IP) per UTC day, and per minute.
XRAY_DAILY_LIMIT=8
XRAY_MINUTE_LIMIT=3
